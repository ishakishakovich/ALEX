local function RefreshPlayerList()
    local existing = {}
    for _, child in ipairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then existing[child.Name] = child end
    end
    local y = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local key = "P_" .. p.UserId
            local btn = existing[key]
            if not btn then
                btn = Instance.new("TextButton")
                btn.Name = key
                btn.Size = UDim2.new(1, -10, 0, 30)
                btn.Font = Enum.Font.Gotham
                btn.TextSize = 11
                btn.Parent = PlayerList
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 4)
                corner.Parent = btn
                btn.MouseButton1Click:Connect(function()
                    if Config.LockedPlayer == p then
                        Config.LockedPlayer = nil
                    else
                        Config.LockedPlayer = p
                    end
                    RefreshPlayerList()
                end)
            end
            btn.Position = UDim2.new(0, 5, 0, y)
            btn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            btn.BackgroundColor3 = (Config.LockedPlayer == p) and Color3.fromRGB(80, 40, 40) or Color3.fromRGB(35, 35, 45)
            btn.TextColor3 = Color3.fromRGB(200, 200, 220)
            existing[key] = nil
            y = y + 34
        end
    end
    -- clean stale
    for _, btn in pairs(existing) do btn:Destroy() end
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, y)
end
_G.ShivRefreshPlayers = RefreshPlayerList
RefreshPlayerList()
Players.PlayerAdded:Connect(function() task.wait(0.3) RefreshPlayerList() end)
Players.PlayerRemoving:Connect(function(p)
    if Config.LockedPlayer == p then Config.LockedPlayer = nil end
    task.wait(0.3)
