local ToggleRegistry = {}
local function CreateToggle(parent, text, key, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(180, 180, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    local entry = { button = btn, label = text, key = key }
    table.insert(ToggleRegistry, entry)
    btn.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        btn.Text = text .. ": " .. (Config[key] and "ON" or "OFF")
        btn.BackgroundColor3 = Config[key] and Color3.fromRGB(40, 70, 50) or Color3.fromRGB(35, 35, 45)
        if callback then callback(Config[key]) end
    end)
    return btn
end

_G.ShivRefreshUI = function()
    for _, e in ipairs(ToggleRegistry) do
        if e.key then
            e.button.Text = e.label .. ": " .. (Config[e.key] and "ON" or "OFF")
            e.button.BackgroundColor3 = Config[e.key] and Color3.fromRGB(40, 70, 50) or Color3.fromRGB(35, 35, 45)
        end
    end
    if _G.ShivRefreshPlayers then _G.ShivRefreshPlayers() end
end

